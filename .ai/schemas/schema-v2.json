{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VictoriousMarketTestResultSchemaV2",
  "description": "Authoritative machine-readable test result schema v2 generated by runner scripts",
  "type": "object",
  "required": [
    "schema",
    "ticket",
    "commit",
    "branch",
    "tier",
    "baseline_ref",
    "produced_by",
    "produced_at",
    "results"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 2
    },
    "ticket": {
      "type": "string",
      "pattern": "^VM-[A-Z0-9]+-[0-9]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,40}$"
    },
    "branch": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": ["A", "B", "C"]
    },
    "baseline_ref": {
      "type": "string"
    },
    "produced_by": {
      "type": "string"
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "results": {
      "type": "object",
      "required": [
        "backend",
        "customer_frontend",
        "vendor_frontend",
        "operations_frontend",
        "contract",
        "integration",
        "e2e",
        "security",
        "database",
        "regression",
        "performance",
        "client_compat",
        "static_analysis",
        "dependency_scan",
        "secret_scan",
        "license",
        "build"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "N/A", "NOT_RUN"]
          },
          "log_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "justification": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          },
          "legacy_debt_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "quarantined": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
